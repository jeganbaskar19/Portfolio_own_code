# =====================================================
# PORTFOLIO AI ASSISTANT — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys.
# NEVER commit .env to Git.
# =====================================================

# AI Provider to use as primary: groq | gemini | openrouter
AI_PROVIDER=groq

# ---- Groq (Recommended — fastest, 14,400 req/day free) ----
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use with Groq (default: llama-3.1-8b-instant)
# Other free options: llama3-8b-8192, mixtral-8x7b-32768, gemma2-9b-it
AI_MODEL=llama-3.1-8b-instant

# ---- Google Gemini (Optional fallback — 1,500 req/day free) ----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- OpenRouter (Optional fallback — free models available) ----
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
